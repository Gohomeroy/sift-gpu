# ── SIFT GPU Worker — Environment Config ───────────────────────────────
# Copy to .env.gpu and fill in. NEVER commit .env files.
# ────────────────────────────────────────────────────────────────────────

# Supabase (same as your local worker)
SUPABASE_URL=https://lmgrfygmkdbejiyrbchp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Model paths (inside the container)
MODEL_PATH=/app/models/Qwen3-VL-8B-Instruct-Q4_K_M.gguf
MMPROJECT_PATH=/app/models/mmproj-Qwen3-VL-8B-F16.gguf

# llama-server config
LLAMA_PORT=8080
LLAMA_CTX=4096
LLAMA_THREADS=4

# Whisper model: tiny | base | small | medium
WHISPER_MODEL=base

# Render server
RENDER_PORT=3001

# Worker polling
WORKER_POLL=5

# Optional: CSV of viral transcripts for semantic scoring
VIRAL_CSV_PATH=

# VL discovery settings
VL_DISCOVER_ENABLED=1
VL_DISCOVER_FRAMES=24
VL_DISCOVER_BATCH=12
VL_DISCOVER_WIDTH=384

# ── Social posting ──────────────────────────────────────────────────────

POSTING_ENABLED=1
POST_POLL_INTERVAL=10

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram / Facebook
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
