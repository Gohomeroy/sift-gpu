# Copy to worker/.env and fill in. NEVER commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Optional: Qwen2.5-VL via llama.cpp server (OpenAI-compatible endpoint).
# Start: llama-server -m Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf --mmproj mmproj-*.gguf
# When unreachable, the worker skips visual scoring gracefully.
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Optional: CSV of viral transcripts (transcript column) to build semantic
# centroids from. Falls back to heuristics-only scoring when absent.
VIRAL_CSV_PATH=

# Model size for faster-whisper: tiny | base | small | medium
WHISPER_MODEL=base

# How many candidate windows the VL pass watches (CPU cost scales with this)
VL_TOP_N=8

# Render server (Remotion) address
RENDER_SERVER_URL=http://127.0.0.1:3001

# Reframe engine: v1 (YuNet original) or v2 (MediaPipe + YOLOv8, smarter tracking)
REFRAME_ENGINE=v2

# Working directory for downloads/renders (defaults to ./tmp)
WORK_DIR=

# ── Hook overlays ────────────────────────────────────────────────────────

# Hook text style: classic | dark | yellow | red | outline | outline_yellow
HOOK_STYLE=classic

# Hook position on screen: top | center | bottom
HOOK_POSITION=top

# How many seconds the hook overlay stays visible
HOOK_DURATION=4

# ── Social posting ──────────────────────────────────────────────────────

# Enable/disable social posting (1=enabled, 0=disabled)
POSTING_ENABLED=1

# How often to poll for queued posts (seconds)
POST_POLL_INTERVAL=10

# TikTok API credentials (for posting clips)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube / Google API credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram / Facebook API credentials
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
