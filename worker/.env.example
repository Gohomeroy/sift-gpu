# SIFT worker .env template — copy to worker/.env on the pod and fill in secrets.
# IMPORTANT: never commit worker/.env. This file is the reproducible source of truth.
# Source of values: worker/config.py. Optional vars are commented out.

# ── Supabase (REQUIRED) ─────────────────────────────────────────────
SUPABASE_URL=https://lmgrfygmkdbejiyrbchp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Local model servers (REQUIRED) ──────────────────────────────────
LLAMA_SERVER_URL=http://127.0.0.1:8080
RENDER_SERVER_URL=http://127.0.0.1:3002

# ── HuggingFace (only if models need downloading) ───────────────────
HF_TOKEN=

# ── Cache / storage ─────────────────────────────────────────────────
WORK_DIR=/workspace/sift/tmp
WHISPER_MODEL=base
VL_TOP_N=8
REFRAME_ENGINE=v2
CLIP_MEMORY_ENABLED=1

# ── yt-dlp ──────────────────────────────────────────────────────────
YTDLP_COOKIES_FILE=
YTDLP_PROXY=

# ── Posting loop ────────────────────────────────────────────────────
POSTING_ENABLED=1
POST_POLL_INTERVAL=10

# ── VL discovery (auto/fallback content) ────────────────────────────
VL_DISCOVER_ENABLED=1
VL_DISCOVER_FRAMES=12
VL_DISCOVER_BATCH=12
VL_DISCOVER_WIDTH=384
VL_DISCOVER_MIN_DUR=15
VL_DISCOVER_MAX_DUR=90

# ── Hooks ───────────────────────────────────────────────────────────
HOOKS_ENABLED=0
HOOK_STYLE=classic
HOOK_POSITION=top
HOOK_DURATION=4

# ── Streamer moment intelligence ────────────────────────────────────
STREAMER_MODE=0
STREAMER_MAX_EVENTS=120
STREAMER_MAX_SEQUENCES=36
STREAMER_MERGE_GAP=6.0
STREAMER_AUDIO_BUCKET=0.5
STREAMER_MAX_SEQ_SPAN=120.0
STREAMER_CONTEXT_VARIANTS=4
STREAMER_CONTEXT_PRE=12.0
STREAMER_CONTEXT_POST=16.0
STREAMER_CONTEXT_SPREAD=0.5
STREAMER_DENSE_FRAMES=9
STREAMER_DENSE_WIDTH=512
STREAMER_ANALYZE_PRE=
STREAMER_ANALYZE_POST=
STREAMER_PASS_A_LIMIT=
STREAMER_PASS_B_LIMIT=
STREAMER_TEMPERATURE=
STREAMER_MIN_CLIP=
STREAMER_MAX_CLIP=

# ── Social platform OAuth (optional, for posting) ───────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Legacy model path ───────────────────────────────────────────────
VIRAL_CSV_PATH=